<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hungnv.bitbucket-pr-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Bitbucket PR Worker.app/Contents/MacOS/WorkerLauncher</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__USER_HOME__/Library/Logs/BitbucketPRWorker/worker.log</string>
  <key>StandardErrorPath</key>
  <string>__USER_HOME__/Library/Logs/BitbucketPRWorker/worker-error.log</string>
</dict>
</plist>
