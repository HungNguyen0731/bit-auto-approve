# Public HTTPS URL configured for this application in Coolify.
CONTROL_PLANE_ORIGIN=https://bit-auto-approve.example.com

# Set only in Coolify; use a long, unique secret.
CONTROL_PLANE_OWNER_PASSWORD=replace-with-a-long-unique-secret

# Bitbucket OAuth consumer with callback exactly:
# https://YOUR_CONTROL_PLANE_ORIGIN/api/accounts/oauth/callback
# Grant account/read, repository/read, pullrequest/read, pullrequest/write and pipeline/build status permissions as required by jobs.
BITBUCKET_OAUTH_CLIENT_ID=
BITBUCKET_OAUTH_CLIENT_SECRET=

# Optional local Docker Compose port.
APP_PORT=3100
